# Copy to .env on the home machine. Never commit real secrets.

MANHUNT_ENV=home
MANHUNT_DEV_AUTH=true
MANHUNT_DATABASE_URL=postgresql+psycopg://manhunt:manhunt@127.0.0.1:5432/manhunt
MANHUNT_SESSION_SIGNING_KEY=replace-with-a-long-random-string
MANHUNT_QR_SIGNING_KEY=replace-with-a-different-long-random-string
MANHUNT_APPLE_AUDIENCE=app.manhunt.ios
MANHUNT_TICK_LOOP=true
MANHUNT_TRAIL_KEY=replace-with-64-hex-chars
MANHUNT_TRAIL_KEY_ID=v1
# TUNNEL_TOKEN is read by docker compose --profile tunnel. Keep it out of git.
# TUNNEL_TOKEN=
